  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.url.path.includes('login') && pm.response.code === 200) {",
          "    var jsonData = pm.response.json();",
          "    if (jsonData.accessToken) pm.collectionVariables.set('accessToken', jsonData.accessToken);",
          "    if (jsonData.refreshToken) pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
          "}",
          "if (pm.request.url.path.includes('refresh') && pm.response.code === 200) {",
          "    var jsonData = pm.response.json();",
          "    if (jsonData.accessToken) pm.collectionVariables.set('accessToken', jsonData.accessToken);",
          "}",
          "if (pm.request.url.path.includes('refresh-token') && pm.response.code === 200) {",
          "    var jsonData = pm.response.json();",
          "    if (jsonData.refreshToken) pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
          "}"
        ]
      }
    }
